table gold_fact_shipments
	lineageTag: 7e287628-537c-4600-9db8-e897966cca56
	sourceLineageTag: [dbo].[gold_fact_shipments]

	measure Shipments = ```
			COUNTROWS ( gold_fact_shipments )
			
			```
		formatString: 0
		lineageTag: 0bb86567-0496-4120-a41b-7b8789843d26

		changedProperty = Name

	measure 'Total Revenue' = ```
			SUM ( gold_fact_shipments[customer_revenue_eur] )
			
			```
		lineageTag: b5be7e56-7d40-4124-9bba-586cbe82bb65

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cost' = ```
			SUM ( gold_fact_shipments[total_cost_eur] )
			
			```
		lineageTag: 9738ef17-de97-4ccb-9ef4-0145c08437c5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Margin = ```
			[Total Revenue] - [Total Cost]
			
			```
		lineageTag: ba1f43d7-6278-4170-847d-ed78b05119d6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Margin %' = ```
			DIVIDE ( [Margin], [Total Revenue] )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dc439944-e4fa-48d9-bb4c-26451b11c40a

		changedProperty = Name

		changedProperty = FormatString

	measure 'Total KM' = ```
			SUM ( gold_fact_shipments[distance_km] )
			
			```
		formatString: #,0
		lineageTag: db11d54f-cf73-4dcc-ae81-476b8890e850

		changedProperty = Name

		changedProperty = FormatString

	measure 'Cost per KM' =
			
			DIVIDE ( [Total Cost], [Total KM] )
		lineageTag: 13401c5b-7c6f-4bec-ab76-55c211d25a67

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OTD %' =
			
			DIVIDE (
			    CALCULATE (
			        [Shipments],
			        FILTER (
			            gold_fact_shipments,
			            gold_fact_shipments[transit_hours]
			                <= RELATED ( gold_dim_lanes[std_transit_hours] ) + 6
			        )
			    ),
			    [Shipments]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ccdd2aec-4863-4af8-b764-c0bda6764ab1

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Transit Hours' = ```
			AVERAGE ( gold_fact_shipments[transit_hours] )
			
			```
		lineageTag: bad70f7d-d1fe-4802-bd0c-97ca2448d64a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per Tonne' =
			
			DIVIDE ( [Total Revenue], SUM ( gold_fact_shipments[weight_kg] ) / 1000 )
		lineageTag: 54c8c43f-fa20-4cf4-9ad6-6237066cf3a9

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lanes below half average margin' =
			
			VAR AvgLaneMargin =
			    DIVIDE ( [Margin], DISTINCTCOUNT ( gold_dim_lanes[lane_id] ) )
			RETURN
			    COUNTROWS (
			        FILTER ( VALUES ( gold_dim_lanes[lane_id] ), [Margin] < AvgLaneMargin * 0.5 )
			    )
		lineageTag: 43b5e9c1-08aa-42b6-860b-8d1ba9046c68

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Margin per KM' = DIVIDE ( [Margin], [Total KM] )
		lineageTag: e26ba66f-f0ce-4185-a35d-5ee827a0da44

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

