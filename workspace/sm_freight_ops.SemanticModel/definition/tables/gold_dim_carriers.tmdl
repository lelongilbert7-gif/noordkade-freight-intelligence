table gold_dim_carriers
	lineageTag: b961bb27-a5b8-4b6e-9933-304940adde58
	sourceLineageTag: [dbo].[gold_dim_carriers]

	measure 'Carriers below SLA' =
			
			COUNTROWS (
			    FILTER ( VALUES ( gold_dim_carriers[carrier_id] ), [OTD %] < 0.85 )
			)
